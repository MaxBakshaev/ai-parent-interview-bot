    {
      "parameters": {
        "jsCode": "const raw = $('Prepare History For Storage').first().json.text || $json.output || '';\n\n// Detect leaked raw tool-call / XML-invoke syntax that should never reach the user\nconst leakPattern = /<invoke[\\s\\S]*|<\\/?parameter[\\s\\S]*|Calling\\s+\\w+/i;\nconst match = raw.match(leakPattern);\n\nlet clean = raw;\nif (match) {\n  clean = raw.slice(0, match.index).trim();\n}\n\nif (!clean) {\n  clean = 'Ой, кажется у меня на секунду пропала связь. Не могли бы вы, пожалуйста, повторить ваш последний ответ?';\n}\n\nreturn [{ json: { output: clean } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
