      "id": "545b614e-00c4-446e-85b4-01c55eda8489",
      "name": "Get Conversation History",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('Telegram Trigger').item.json;\nconst chatId = trigger.message.chat.id;\nconst rawText = trigger.message.text;\nconst userText = (rawText && rawText.trim().length > 0)\n  ? rawText\n  : '[Пользователь отправил сообщение без текста — вероятно, фото, голосовое сообщение, стикер или файл]';\n\nconst mongoResult = $input.first().json;\nlet history = [];\nif (mongoResult && mongoResult.messages_json) {\n  try { history = JSON.parse(mongoResult.messages_json); } catch (e) { history = []; }\n}\n\nconst newMessages = [...history, { role: 'user', content: [{ type: 'text', text: userText }] }];\n\nreturn [{\n  json: {\n    chat_id: String(chatId),\n    messages_json: JSON.stringify(newMessages),\n    iteration: 0\n  }\n}];\n"
      },
