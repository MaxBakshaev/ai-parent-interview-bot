    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n// Detect leaked tool-call JSON fragments that occasionally spill into a field's value\n// (e.g. a missing closing quote causes the next parameter's JSON, or the tool_use id, to leak in)\nconst leakPattern = /\",\\s*\"[a-zA-Z_]+\"\\s*:\\s*\"|\"id\":\"toolu_[a-zA-Z0-9]*\"|<\\/invoke>/;\n\nconst cleaned = {};\nfor (const [key, value] of Object.entries(item)) {\n  if (typeof value === 'string') {\n    const match = value.match(leakPattern);\n    let v = match ? value.slice(0, match.index) : value;\n    v = v.replace(/[\"\\s]+$/, '').trim();\n    cleaned[key] = v;\n  } else {\n    cleaned[key] = value;\n  }\n}\n\nreturn [{ json: cleaned }];\n"
      },
